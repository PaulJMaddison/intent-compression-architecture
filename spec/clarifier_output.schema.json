{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PaulJMaddison/kynticai-clarity-gateway-reference/blob/main/spec/clarifier_output.schema.json",
  "title": "ICA Clarifier Output",
  "description": "Structured decision object emitted by an Intent Compression Architecture control layer before answer generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ambiguity_score", "risk_score", "intent_entropy_bits", "intent_hypotheses", "decision", "answer_constraints"],
  "properties": {
    "query_id": {"type": ["string", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "ambiguity_score": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
    "intent_entropy_bits": {"type": "number", "minimum": 0},
    "risk_labels": {"type": "array", "items": {"type": "string"}},
    "intent_hypotheses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "probability", "answer_delta_if_true"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "answer_delta_if_true": {"type": "string", "enum": ["low", "medium", "high"]},
          "notes": {"type": ["string", "null"]},
          "metadata": {"type": ["object", "null"], "additionalProperties": true}
        }
      }
    },
    "candidate_clarifiers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "question", "expected_information_gain_bits", "expected_utility", "estimated_cost_tokens"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "expected_information_gain_bits": {"type": "number", "minimum": 0},
          "expected_utility": {"type": "number"},
          "estimated_cost_tokens": {"type": "number", "minimum": 0},
          "estimated_latency_ms": {"type": ["number", "null"], "minimum": 0},
          "estimated_token_savings": {"type": ["number", "null"]},
          "metadata": {"type": ["object", "null"], "additionalProperties": true}
        }
      }
    },
    "decision": {"type": "string", "enum": ["answer_direct", "ask_clarifier", "premise_check", "refuse_redirect"]},
    "selected_clarifier_id": {"type": ["string", "null"]},
    "clarifying_question": {"type": ["string", "null"]},
    "expected_utility": {"type": ["number", "null"]},
    "decision_threshold": {"type": ["number", "null"]},
    "answer_constraints": {"type": "array", "items": {"type": "string"}},
    "safe_redirect": {"type": ["string", "null"]},
    "rationale": {"type": "string", "default": ""},
    "estimated_token_savings": {"type": ["number", "null"]},
    "metadata": {"type": ["object", "null"], "additionalProperties": true}
  }
}
